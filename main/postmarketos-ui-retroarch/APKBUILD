# Reference: https://postmarketos.org/uipkg
# Co-Maintainer: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
maintainer="Sandelinos <postmarketos@sandelinos.me>"
pkgname=postmarketos-ui-retroarch
pkgver=3
pkgrel=0
pkgdesc="RetroArch in KMS mode"
url="https://www.retroarch.com"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	autologin
	retroarch
	seatd
	"
depends_openrc="mkrundir"
install="postmarketos-ui-retroarch-openrc.post-install postmarketos-ui-retroarch-openrc.post-upgrade"
subpackages="$pkgname-openrc"
source="
	retroarch.initd
	postmarketos-ui-retroarch.sh
	"
options="!check pmb:drm pmb:default-openrc pmb:support-openrc pmb:support-systemd"
_pmb_groups="seat"

package() {
	install -Dm755 retroarch.initd "$pkgdir/etc/init.d/retroarch"
	install -Dm755 postmarketos-ui-retroarch.sh "$pkgdir/usr/bin/postmarketos-ui-retroarch"
}

