#!/bin/busybox ash
# This special service is ran by nitro early on startup, before any other services
# are brought up.
exec 2>&1

for b in halt poweroff reboot; do
	busybox ln -s /usr/bin/nitroctl /usr/bin/"$b"
done
/usr/bin/busybox --install -s
/usr/bin/busybox-extras --install -s

# Only needed for SYS, while the special LOG@ service isn't used yet
# other services have their stdout forwarded to LOG@<service> automatically
# (which interacts with syslogd).
log() {
	logger -t "Nura-rd[SYS]" -p daemon.info "$@"
}

logpipe() {
	logger -t "Nura-rd[SYS]" -p daemon.info
}

# mark all services down, we will start them in order in target@
for s in /usr/share/initramfs/svc/*; do
	# special-case SYS/LOG@/bootup services
	if [ "$s" != "/usr/share/initramfs/svc/SYS" ] &&
	   [ "$s" != "/usr/share/initramfs/svc/LOG@" ] &&
	   [ "$s" != "/usr/share/initramfs/svc/bootup" ]; then
		touch "$s"/down | logpipe
	fi
done

# start modules early
nitroctl -v start modules | logpipe

# mount a few things
# /dev and /run is already mounted by nitro, we can just mount the rest
mount -t proc -o nodev,noexec,nosuid proc /proc | logpipe || log "Couldn't mount /proc"
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys | logpipe || log "Couldn't mount /sys"
mount -t configfs -o nodev,noexec,nosuid configfs /sys/kernel/config | logpipe || log "Couldn't mount configfs"

# start syslogd early
nitroctl -v up syslogd | logpipe
log "Nura initramfs $(< /usr/share/initramfs/version) is starting"

# /dev/pts (needed for telnet)
mkdir -p /dev/pts | logpipe
mount -t devpts devpts /dev/pts | logpipe

# setting up firmware directory
sysfs_dir=/sys/module/firmware_class/parameters/path
if ! [ -e "$sysfs_dir" ]; then
	log "Kernel does not support setting the firmware image search path. Skipping."
	return
fi
# shellcheck disable=SC3037
echo -n /lib/firmware/postmarketos >$sysfs_dir

log "early init completed successfully"
