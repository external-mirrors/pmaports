#!/bin/sh
partition="$(blkid --uuid "$1")"

if [ -z "$partition" ]; then
	partition="$(blkid --label "$1")"
	if [ -z "$partition" ]; then
		partition="$(blkid --match-token "TYPE=crypto_LUKS" | cut -d ":" -f 1 | head -n 1)"
	fi
fi

# partition not found
if [ -z "$partition" ]; then
	echo "partition not found!"
	return 111
fi

echo "mounting partition $partition"
type="$(blkid "$partition" | sed 's/^.*\ TYPE="\([a-zA-Z0-9_]*\)".*$/\1/')"

mount_opts="-o nodev,nosuid,noexec"
case "$type" in
	ext*|xfs)
		;;
	vfat)
		mount_opts="-t vfat $mount_opts,umask=0077,nosymfollow,codepage=437,iocharset=ascii"
		;;
	*)
		echo "unknown partition type $type"
		return 111
		;;
esac

if ! mount $mount_opts "$partition" /sysroot/boot; then
	echo "boot: failed to mount $type partition $partition"
	return 111
fi
