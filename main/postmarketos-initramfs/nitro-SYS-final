#!/bin/sh
# This service is ran by nitro after SYS/reincarnate (which is not supposed to return)
# we exploit this to show an error message

echo "Nura-rd[SYS]: ERROR: switch_root failed!" > /dev/kmsg
echo "Nura-rd[SYS]: Looping forever. Install and use the debug-shell hook to debug this." > /dev/kmsg
echo "Nura-rd[SYS]: For more information, see <https://postmarketos.org/debug-shell>" > /dev/kmsg
