package() {
	mkdir -p "$pkgdir"/usr/share/plymouth/themes
	cp -r pmos-spin "$pkgdir"/usr/share/plymouth/themes/
	cp -r pmos-eink "$pkgdir"/usr/share/plymouth/themes/
}

