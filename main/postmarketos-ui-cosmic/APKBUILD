# Reference: https://postmarketos.org/uipkg
maintainer="Clayton Craft <clayton@craftyguy.net>"
pkgname=postmarketos-ui-cosmic
pkgver=3
pkgrel=0
pkgdesc="COSMIC Desktop Environment from System76"
url="https://system76.com/cosmic/"
# Only tested on these archs.
# If you want to add support for a new arch add it here and in the Alpine
# packages and build locally.
arch="x86_64 aarch64 ppc64le loongarch64"
license="GPL-3.0-or-later"
depends="
	bluez
	cosmic-session
	gst-thumbnailers
	polkit-elogind
	postmarketos-base-ui
	postmarketos-base-ui-audio-backend-pipewire
	postmarketos-base-ui-networkmanager
	power-profiles-provider
	upower
	xdg-desktop-portal-gtk
	xdg-user-dirs
"
_pmb_recommends="
	cosmic-edit
	cosmic-initial-setup
	cosmic-monitor
	cosmic-player
	cosmic-store
	cosmic-sound-theme
	cosmic-term
	cups
	firefox-esr
	flatpak
	gnome-keyring
	gst-libav
	gst-plugins-bad
	gst-plugins-good
	gst-plugins-rs-dav1d
	papers
	postmarketos-artwork-wallpapers
	snapshot
	tuned-ppd
"
source="
	60-postmarketos-cosmic.preset
	amplification_sink.conf
	favorites.conf
	wallpaper.conf
"
options="!check pmb:drm pmb:default-systemd pmb:support-systemd"
replaces="
	cosmic-applets
	cosmic-bg
"

package() {
	install -Dm644 wallpaper.conf \
		"$pkgdir"/usr/share/cosmic/com.system76.CosmicBackground/v1/all
	install -Dm644 favorites.conf \
		"$pkgdir"/usr/share/cosmic/com.system76.CosmicAppList/v1/favorites
	install -Dm644 amplification_sink.conf \
		"$pkgdir"/usr/share/cosmic/com.system76.CosmicAudio/v1/amplification_sink

	install -Dm644 60-postmarketos-cosmic.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset
}

