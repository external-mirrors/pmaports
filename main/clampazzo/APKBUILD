maintainer="Clayton Craft <clayton@craftyguy.net>"
pkgname=clampazzo
pkgver=1.0.0
pkgrel=0
pkgdesc="Set the minimum scheduler clamp performance floor for wayland compositors"
url="https://gitlab.postmarketos.org/postmarketOS/pmaports"
arch="all"
license="GPL-3.0-or-later"
source="clampazzo clampazzo.service clampazzo.path"
depends="lsof util-linux-misc"
options="!check"  # no tests
subpackages="$pkgname-systemd"

package() {
	install -Dm755 clampazzo \
		-t "$pkgdir"/usr/bin
	install -Dm644 clampazzo.path \
		-t "$pkgdir"/usr/lib/systemd/user
	install -Dm644 clampazzo.service \
		-t "$pkgdir"/usr/lib/systemd/user
}

