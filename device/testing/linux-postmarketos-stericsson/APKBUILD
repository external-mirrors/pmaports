44396d5eca70a9c818de96c62daf7198e968d332550961d668e927f5b35e90e9723b8c3316455ef1472c09d39fd15ef74a254376f4232a702e3221e8657600a6  config-postmarketos-stericsson.armv7
2ba9304f4f2d8578906017699255aadb10d1f0dc62704400632859b9bdad06a10c5837ce1a524813b1d205b33e8b5f7990038a700942e2ee728b79b7ecc45282  drm-regressions.patch
"
