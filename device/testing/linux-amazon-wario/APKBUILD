# Kernel config based on: arch/arm/configs/wario_defconfig
maintainer="James Coxon <solarcene@protonmail.com>"
pkgname=linux-amazon-wario
pkgver=7.1.10
pkgrel=0
_commit="8c68d420f2a30cfdd6673d971e8ae325e9835fe6"
pkgdesc="Amazon Kindle Paperwhite3 (wario) Fork of i.MX E-Book reader kernel fork, close to mainline"
provides="linux-amazon-wario-mainline=$pkgver-r$pkgrel"
arch="armv7"
_carch="arm"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-nftables"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	llvm
	lld
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"
source="
	$pkgname-$_commit.tar.gz::https://github.com/akemnade/linux/archive/$_commit.tar.gz
	config-${pkgname#linux-}.$arch
	0001-Wario-fix-for-suspend-to-mem-CFI-triggered-oops.patch
	0002-Wario-add-drivers-for-MAX77696-MFD-REG-for-CPU-USB-E.patch
	0003-Wario-MAX77696-Battery-Fuel-Gauge-Driver.patch
	0004-Wario-MAX77696-OnKey-driver.patch
	0005-Wario-add-driver-for-MAX77696-Backlight-WLED-driver.patch
	0006-Wario-cyttsp4-driver-ported-from-6.x-includes-fix-fo.patch
	0007-Wario-add-imx6sl-kindle-pw3.dts.patch
"
builddir="$srcdir/linux-$_commit"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor' and '_config'.
_config="config-${pkgname#linux-}.$arch"
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	cp -v "$srcdir"/config-${pkgname#linux-}.$arch .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$(( pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		LLVM=1 \
		ARCH="$_carch" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/${pkgname#linux-}/kernel.release"
}

