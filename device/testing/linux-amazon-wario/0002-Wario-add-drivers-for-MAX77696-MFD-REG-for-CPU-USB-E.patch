+
+#ifndef MAX77696_H
+#define MAX77696_H
+
+#include <linux/bits.h>
+
+struct max77696 {
+        struct regmap *regmap;
+        struct device *dev;
+};
+
+#define MAX77696_REG_CID		0x0
+
+#define EPDCNFG_REG       0x60
+#define EPDCNFG_EPDEN     BIT(7)
+#define EPDCNFG_VCOMEN    BIT(6)
+#define EPDCNFG_SSHVDDH   BIT(1)
+
+#define EPDVCOM_REG       0x64
+#define EPDVCOMR_REG      0xB4
+#define EPDVCOMR_VCOMR    BIT(0)
+
+/*
+ * EPDINT (0x62) — interrupt/fault status register.
+ * Bit 6 (0x40): VCOM fault.
+ *
+ *  The stock driver retries up to MAX77696_EPD_VCOM_FAULT_RETRIES 
+ *  times with a fixed delay before giving up.
+ */
+
+#define EPDINT_REG              0x62
+#define EPDINT_VCOM_FAULT       BIT(6)
+#define MAX77696_EPD_VCOM_FAULT_RETRIES   5
+#define MAX77696_EPD_VCOM_SETTLE_MS       100
+#define MAX77696_EPD_VCOM_RETRY_DELAY_MS  100
+
+#define LSW4_CNTRL_REG    0x5F
+#define LSW4_OUTLS        BIT(0)
+
+/* WLED register addresses */
+#define LEDBST_CNTRL1_REG   0x6C
+#define LEDBST_CNTRL1_LED1EN    BIT(7)  /* boost + LED enable */
+
+#define LED1CURRENT_1_REG   0x6D   /* bits 11:4 of brightness (MSB) */
+#define LED1CURRENT_2_REG   0x6E   /* bits  3:0 of brightness (LSB) */
+
+#define MAX77696_BL_MAX_BRIGHTNESS  0xFFF  /* 12-bit DAC */
+#define MAX77696_BL_MIN_BRIGHTNESS  0
+
+#define GLBLINT_REG                      0x05
+#define GLBLINTM_REG                     0x06
+#define GLBLSTAT_REG                     0x07
+
+#define GLBLINT_EN0_R                    BIT (7)
+#define GLBLINT_EN0_F                    BIT (6)
+#define GLBLINT_EN0_1SEC                 BIT (5)
+#define GLBLINT_MRWRN                    BIT (4)
+#define GLBLINT_MBATTLOW_R               BIT (3)
+#define GLBLINT_TJALRM1_R                BIT (2)
+#define GLBLINT_TJALRM2_R                BIT (1)
+#define GLBLINT_IRQ                      BIT (0)
+
+/* IRQ */
+#define INTTOP1_REG         0xA2
+#define INTTOP1M_REG        0xA3
+
+#define TOPSYSINT_M         BIT (7)
+
+/* LDO_L02 */
+
+#define LDO_L02_CNFG1_REG 0x45
+#define LDO_PWRMD_NORMAL 0xC0
+#define LDO_PWRMD_MASK 0xC0
+#define MAX77696_LDO_POWERMODE_OFF                0b00
+#define MAX77696_LDO_POWERMODE_NORMAL             0b11
+
+#define MAX77696_BUCK_MIN_UV            600000
+#define MAX77696_BUCK_STEP_UV           12500
+#define MAX77696_BUCK_N_VOLTAGES        224     /* 600 mV .. 3387.5 mV */
+#define MAX77696_BUCK_VSEL_MASK         0xff
+#define MAX77696_BUCK_PWRMD_MASK        0x30
+#define MAX77696_BUCK1_VOUT_REG         0x31
+#define MAX77696_BUCK1_CNFG_REG         0x39
+
+#endif /* MAX77696_H */
