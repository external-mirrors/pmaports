license="BSD-3-Clause"
provides="alsa-ucm-conf=0.$pkgver-r$pkgrel" # versioned provides need to be below default version
source="alsa-ucm-conf-$_commit.tar.gz::https://github.com/sm7125-mainline/alsa-ucm-conf/archive/$_commit/alsa-ucm-conf-$_commit.tar.gz"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	# install audio config files
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2
	cp -r ucm2 "$pkgdir"/usr/share/alsa/
}

