# Reference: <https://nura.eco/devicepkg>
maintainer="Linus Walleij <linusw@kernel.org>"
pkgname=device-samsung-skomer
pkgdesc="Samsung Galaxy Xcover 2"
pkgver=11
pkgrel=0
url="https://nura.eco"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-samsung-u8500
	linux-postmarketos-stericsson
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-kwin"
source="
	deviceinfo
	kernel-cmdline.conf
	kwin.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kwin() {
	install_if="$pkgname kwin"
	install -Dm644 "$srcdir"/kwin.sh "$subpkgdir"/etc/profile.d/kwin.sh
}

