4f2c8022586eb6aa1498ec74f21249d509a1be25336c486af8755e4d603ba3dbc46ac2f2cc47bd9f792dad1c3137da3e5e0f8806eea8dd9979511f3a73016602  config-postmarketos-mediatek-mt6757.aarch64
"
