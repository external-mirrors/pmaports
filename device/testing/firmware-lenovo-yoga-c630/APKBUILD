maintainer="Casey Connolly <kcxt@postmarketos.org>"
pkgname=firmware-lenovo-yoga-c630
pkgver=2
pkgrel=0
_commit="6ddfd13d1bb0dcaf56dd0ffe9387f745a08eb80f"
pkgdesc="Firmware for Lenovo Yoga C630"
url="https://gitlab.com/sdm845-mainline/firmware-lenovo-yoga-c630"
arch="aarch64"
depends="linux-firmware-qcom linux-firmware-ath10k"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="$pkgname-$_commit.tar.gz::https://gitlab.com/sdm845-mainline/firmware-lenovo-yoga-c630/-/archive/$_commit/$pkgname-$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

package() {
	local firmware_paths
	firmware_paths="
		postmarketos/qca/crbtfw21.tlv
		postmarketos/qca/crnv21.bin
		postmarketos/ipa_fws.mdt
		qcom/sdm850/LENOVO/81JL/adspr.jsn
		qcom/sdm850/LENOVO/81JL/adspua.jsn
		qcom/sdm850/LENOVO/81JL/cdspr.jsn
		qcom/sdm850/LENOVO/81JL/modemuw.jsn
		qcom/sdm850/LENOVO/81JL/qcadsp850.mbn
		qcom/sdm850/LENOVO/81JL/qccdsp850.mbn
		qcom/sdm850/LENOVO/81JL/qcdsp1v2850.mbn
		qcom/sdm850/LENOVO/81JL/qcdsp1v2850_nm.mbn
		qcom/sdm850/LENOVO/81JL/qcdsp2850.mbn
		qcom/sdm850/LENOVO/81JL/qcdsp2850_nm.mbn
		qcom/sdm850/LENOVO/81JL/qcdxkmsuc850.mbn
		qcom/sdm850/LENOVO/81JL/qcslpi850.mbn
		qcom/sdm850/LENOVO/81JL/qcslpi850_cls.mbn
		qcom/sdm850/LENOVO/81JL/qcvss850.mbn
		qcom/sdm850/LENOVO/81JL/wlanmdsp.mbn
	"

	for path in $firmware_paths; do
		install -Dm644 "$builddir"/lib/firmware/"$path" \
			"$pkgdir"/usr/lib/firmware/"$path"
	done
}

sha512sums="
