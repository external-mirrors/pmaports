a1b77bf63f8b2d68b6aab6f769599c0c2d09f1b6ddddf75dcafa3a1ce5cd00cf067fb2f3045d3816d511f4cb99afcf4a9683e9bc405e52ba638ef2afb7b13d3f  config-postmarketos-qcom-apq8064.armv7
"
