a482ed029232afb545e896a74bb2ae6c9a942be52c34a43045d141bd7a5a03209b97117b2307ee00a5543c16cbe7ae9b5729ed323619479263109b2e03bc9f99  config-postmarketos-exynos9820.aarch64
"
