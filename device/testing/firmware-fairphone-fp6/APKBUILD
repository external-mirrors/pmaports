maintainer="Luca Weiss <luca@lucaweiss.eu>"
pkgname=firmware-fairphone-fp6
pkgver=20250606
pkgrel=5
pkgdesc="Firmware for The Fairphone (Gen. 6)"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-audio
	$pkgname-bluetooth
	$pkgname-cdsp
	$pkgname-ipa
	$pkgname-modem
	$pkgname-vpu
	$pkgname-wpss
	"
url="https://github.com/FairBlobs/FP6-firmware"
arch="aarch64"
license="proprietary"
makedepends="pil-squasher"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="e58a5be8fa0fb6bc5a5f2e29cc01c036ccf75710"
source="https://github.com/FairBlobs/FP6-firmware/archive/$_commit/FP6-firmware-$_commit.tar.gz"
builddir="$srcdir/FP6-firmware-$_commit"

build() {
	for i in *.mdt; do
		pil-squasher "$(basename "$i" .mdt)".mbn "$i"
	done
}

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

adreno() {
	pkgdesc="The Fairphone (Gen. 6) adreno firmware"

	install -Dm644 "$builddir"/gen80300_zap.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	# TODO: Remove once firmware files are in linux-firmware
	install -Dm644 "$builddir"/gen80300_gmu.bin -t \
		"$subpkgdir/usr/lib/firmware/postmarketos/"
	install -Dm644 "$builddir"/gen80300_sqe.fw -t \
		"$subpkgdir/usr/lib/firmware/postmarketos/"
}

adsp() {
	pkgdesc="The Fairphone (Gen. 6) adsp firmware"

	install -Dm644 "$builddir"/adsp*.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	install -Dm644 "$builddir"/adsp*.jsn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	install -Dm644 "$builddir"/battmgr.jsn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
}

audio() {
	pkgdesc="The Fairphone (Gen. 6) audio amplifier firmware"

	install -Dm644 "$builddir"/aw882xx_acf.bin \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/aw88261_acf.bin"
}

bluetooth() {
	pkgdesc="The Fairphone (Gen. 6) bluetooth firmware"

	install -Dm644 "$builddir"/msbtfw12.mbn -t \
		"$subpkgdir/usr/lib/firmware/qca/"
	install -Dm644 "$builddir"/msnv12.bin -t \
		"$subpkgdir/usr/lib/firmware/qca/"
}

cdsp() {
	pkgdesc="The Fairphone (Gen. 6) cdsp firmware"

	install -Dm644 "$builddir"/cdsp*.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	install -Dm644 "$builddir"/cdsp*.jsn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
}

ipa() {
	pkgdesc="The Fairphone (Gen. 6) ipa firmware"

	install -Dm644 "$builddir"/ipa_fws.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
}

modem() {
	pkgdesc="The Fairphone (Gen. 6) modem firmware"

	install -Dm644 "$builddir"/modem.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	install -Dm644 "$builddir"/modem*.jsn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"

	cp -r "$builddir"/modem_pr/ \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
	find "$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/" \
		-type f -exec chmod 0644 {} \;
}

vpu() {
	pkgdesc="The Fairphone (Gen. 6) vpu firmware"

	install -Dm644 "$builddir"/vpu20_2v.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
}

wpss() {
	pkgdesc="The Fairphone (Gen. 6) wpss firmware"

	install -Dm644 "$builddir"/wpss.mbn -t \
		"$subpkgdir/usr/lib/firmware/qcom/milos/fairphone/fp6/"
}

sha512sums="
c25c38e7f36c82e122d18d1927b85aed600354654280722c832d6d481d9f1acccbd8bf472e8847fc996f1ee6f9882e9db957eeb813f3beae9997bc7ac561fc65  FP6-firmware-e58a5be8fa0fb6bc5a5f2e29cc01c036ccf75710.tar.gz
"
