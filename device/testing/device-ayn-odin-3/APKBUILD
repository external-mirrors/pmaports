# Reference: <https://postmarketos.org/devicepkg>
maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=device-ayn-odin-3
pkgdesc="AYN Odin 3"
pkgver=3
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-ayn
	firmware-ayn-audioreach-topology
	firmware-ayn-odin-3
	hexagonrpcd
	linux-ayn-odin-3
	linux-firmware-ath12k
	linux-firmware-qca
	linux-firmware-qcom
	make-dynpart-mappings
	msm-firmware-loader
	postmarketos-base
	soc-qcom
	soc-qcom-qbootctl
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
source="
	81-libssc-ayn-odin-3.rules
	deviceinfo
	kernel-cmdline.conf
	hexagonrpcd-adsp-sensorspd.service
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# replace /dev/fastrpc-adsp with /dev/fastrpc-adsp-secure and firmware path
	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd.service \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-ayn-odin-3.conf

	install -Dm644 "$srcdir"/81-libssc-ayn-odin-3.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-ayn-odin-3.rules
}

