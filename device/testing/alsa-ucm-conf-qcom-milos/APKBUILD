maintainer="Luca Weiss <luca@lucaweiss.eu>"
pkgname=alsa-ucm-conf-qcom-milos
pkgver=1
pkgrel=0
pkgdesc="ALSA UCM configuration for Milos devices"
url="https://github.com/milos-mainline/alsa-ucm-conf"
arch="aarch64"
license="BSD-3-Clause"
provides="alsa-ucm-conf=0.$pkgver-r$pkgrel" # versioned provides need to be below default version
_commit="036fb47c51520df38de4bc1fb6f59aa73af5a0c6"
source="$pkgname-$_commit.tar.gz::https://github.com/milos-mainline/alsa-ucm-conf/archive/$_commit.tar.gz"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	# install audio config files
	mkdir -p "$pkgdir"/usr/share/alsa
	cp -r ucm2 "$pkgdir"/usr/share/alsa/
}

