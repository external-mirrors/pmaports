source="
	board-2.bin::https://raw.githubusercontent.com/fudio101/active1-pmos/$_blobs_rev/vendor-blobs/board-2.bin
	a512_zap.mbn::https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_xiaomi_wayne-common/$_muppets_rev/proprietary/vendor/firmware/a512_zap.elf
"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"
builddir="$srcdir"

_wlan_dir="usr/lib/firmware/ath10k/WCN3990/hw1.0"
_gpu_dir="usr/lib/firmware/postmarketos"
_fw_features="wowlan,no-nwifi-decap-4addr-padding,allows-mesh-bcast,mgmt-tx-by-ref,non-bmi,single-chan-info-per-channel"

build() {
	ath10k-fwencoder --create \
		--features="$_fw_features" \
		--set-wmi-op-version=tlv \
		--set-htt-op-version=tlv \
		--set-fw-api=5
}

package() {
	install -Dm644 -t "$pkgdir/$_wlan_dir" \
		"$srcdir"/board-2.bin \
		"$srcdir"/firmware-5.bin
	install -Dm644 -t "$pkgdir/$_gpu_dir" \
		"$srcdir"/a512_zap.mbn
}

