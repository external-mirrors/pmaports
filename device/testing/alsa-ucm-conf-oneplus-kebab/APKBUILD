maintainer="Frieder Hannenheim <git@fhannenheim.net>"
pkgname=alsa-ucm-conf-oneplus-kebab
pkgver=1
pkgrel=0
pkgdesc="ALSA UCM configuration for oneplus kebab"
url="https://nura.eco"
arch="aarch64"
license="BSD-3-Clause"
depends="alsa-ucm-conf"
source="
	OnePlus8T.conf
	HiFi.conf
"
options="!check"
builddir="$srcdir"

package() {
	mv OnePlus8T.conf "OnePlus 8T.conf"
	install -Dm644 "OnePlus 8T.conf" -t "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
	install -Dm644 "HiFi.conf" -t "$pkgdir/usr/share/alsa/ucm2/OnePlus"
}

