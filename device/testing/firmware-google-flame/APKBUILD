# Co-Maintainer: Vladimir Muromskii <vmuromskii@ya.ru>
maintainer="Andrew Gigena <mail@andrewgigena.dev>"
pkgname=firmware-google-flame
pkgver=2
pkgrel=0
_commit="f25f967d19a2f5cee5906bfce313ce734007a6be"
pkgdesc="Firmware for Google Pixel 4"
url="https://gitlab.postmarketos.org/andrewgigena/firmware-google-flame"
arch="aarch64"
license="proprietary"
depends="
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
"
source="$pkgname-$_commit.tar.gz::https://gitlab.postmarketos.org/andrewgigena/firmware-google-flame/-/archive/$_commit.tar.gz
	30-gpu-firmware.files
"
options="
	!archcheck
	!check
	!strip
	!tracedeps
	pmb:cross-native
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	local _firmware_paths="
		postmarketos/ath10k/WCN3990/hw1.0/bdwlan-flame.bin
		postmarketos/ath10k/WCN3990/hw1.0/board-2.bin
		postmarketos/ath10k/WCN3990/hw1.0/board-2.json
		postmarketos/ath10k/WCN3990/hw1.0/firmware-5.bin
		postmarketos/qca/crbtfw01.tlv
		qca/crnv01.bin
		qcom/a630_gmu.bin
		qcom/a630_sqe.fw
		qcom/a640_gmu.bin
		qcom/sm8150/google/flame/a640_zap.mbn.zst
		qcom/sm8150/google/flame/adsp.mbn.zst
		qcom/sm8150/google/flame/adspr.jsn
		qcom/sm8150/google/flame/adspua.jsn
		qcom/sm8150/google/flame/cdsp.mbn.zst
		qcom/sm8150/google/flame/cdspr.jsn
		qcom/sm8150/google/flame/ipa_fws.mbn.zst
		qcom/sm8150/google/flame/modem.mbn.zst
		qcom/sm8150/google/flame/modemr.jsn
		qcom/sm8150/google/flame/modemuw.jsn
		qcom/sm8150/google/flame/slpi.mbn.zst
		qcom/sm8150/google/flame/slpir.jsn
		qcom/sm8150/google/flame/slpius.jsn
		qcom/sm8150/google/flame/venus.mbn.zst
		qcom/sm8150/google/flame/wlanmdsp.mbn.zst
	"

	for path in $_firmware_paths; do
		echo $path
		install -Dm644 "$builddir"/lib/firmware/"$path" \
			"$pkgdir"/usr/lib/firmware/"$path"
	done

	install -Dm644 "$srcdir"/30-gpu-firmware.files \
		"$pkgdir"/usr/share/mkinitfs/files/30-gpu-firmware.files
}

sha512sums="
84ec5875eb5f7ce7daf3a300b9b0d76f61e7bcf160a35b7bdc401d8222439804cf3a849b57618602a9dca37e10b3c83b0a5f6614ba77da883dffcd6db42316be  firmware-google-flame-f25f967d19a2f5cee5906bfce313ce734007a6be.tar.gz
96cca9df1d931301d5928c7cb9242793880ac73309e5da783ae5845afc898df0a9560e828b879f7912a88cf83a5e971e5e97ca0ee7db83ea84e9284f3bc0812d  30-gpu-firmware.files
"
