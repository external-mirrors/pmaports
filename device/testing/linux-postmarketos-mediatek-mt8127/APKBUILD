39fdfe2adcc8ee8a0e2dcf22bd1abc34202e4d53e10f3d9dd8159d229da3a475ad303f9da75841e5774f973203cef147c418b8f6c02cb72ce4eb54e867c15e11  config-postmarketos-mediatek-mt8127.armv7
"
