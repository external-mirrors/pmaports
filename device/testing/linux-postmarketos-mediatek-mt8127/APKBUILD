895757c9e51e6e3e83b299176c0057839e8dc42c2c127d73b62f5b5e4ba0a24d27406942c739735b308e29e8931be0e1e81e2b98d23009da5fbcc8a57446b11a  config-postmarketos-mediatek-mt8127.armv7
"
