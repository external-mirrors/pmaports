c84672dd702acf5cdad7ed57ffa6aaeb4d0cc3c71d1ef4c9f5a1a2450e0f3d085f331c4489ec345c63a89f753c882ce42ba0d661928cd2d4c393f1144286d2b1  config-nura-qcom-sm61x5.aarch64
"
