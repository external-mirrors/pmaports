maintainer="Luca Weiss <luca@lucaweiss.eu>"
pkgname=alsa-ucm-conf-qcom-sm6350
pkgver=2
pkgrel=0
pkgdesc="ALSA UCM configuration for sm6350 devices"
url="https://github.com/sm6350-mainline/alsa-ucm-conf"
arch="aarch64"
license="BSD-3-Clause"
provides="alsa-ucm-conf=0.$pkgver-r$pkgrel" # versioned provides need to be below default version
_commit="df7d4c9c6aa5da21f43a4b656b20f3f7330f77e5"
source="$pkgname-$_commit.tar.gz::https://github.com/sm6350-mainline/alsa-ucm-conf/archive/$_commit.tar.gz"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	# install audio config files
	mkdir -p "$pkgdir"/usr/share/alsa
	cp -r ucm2 "$pkgdir"/usr/share/alsa/
}

