# Reference: <https://postmarketos.org/devicepkg>
maintainer="Henrik Grimler <henrik@grimler.se>"
pkgname=device-odroid-xu4
pkgdesc="ODROID XU4"
pkgver=8
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-postmarketos-exynos5
	postmarketos-base>=25-r1
	u-boot-odroid
	firmware-odroid-xu4
	"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf led-heartbeat.conf modules-initfs"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 led-heartbeat.conf -t "$pkgdir"/usr/lib/modules-load.d
}

