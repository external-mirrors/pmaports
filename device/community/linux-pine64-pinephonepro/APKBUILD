be4eaeb9a3e397f135fd4c89e2bfe2142bf42cb50e3c3769280bb3b396fb4700bef025c52c5e712a9611ca89c4f953ce15d452816fac357d25b7f38d15623e1c  config-pine64-pinephonepro.aarch64
"
