From 5774ba8941ddb45470bfa9cc903d63e52a678b90 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 22 May 2022 03:25:06 +0200
Subject: [PATCH 07/84] media: imx258: Add i2c supply

Sensor depends on I2C bus to be powered up to work.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/imx258.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/media/i2c/imx258.c b/drivers/media/i2c/imx258.c
index bc9ee449a87c..7bfe127daf60 100644
--- a/drivers/media/i2c/imx258.c
+++ b/drivers/media/i2c/imx258.c
@@ -486,6 +486,7 @@ static const char * const imx258_supply_name[] = {
 	"vana",  /* Analog (2.8V) supply */
 	"vdig",  /* Digital Core (1.2V) supply */
 	"vif",  /* IF (1.8V) supply */
+	"i2c",  /* I2C BUS I/O (1.8V) supply */
 };
 
 #define IMX258_NUM_SUPPLIES ARRAY_SIZE(imx258_supply_name)
-- 
2.55.0

