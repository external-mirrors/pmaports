maintainer="Casey Connolly <kcxt@postmarketos.org>"
pkgname=firmware-oneplus-sdm845
pkgver=19
pkgrel=0
_commit="3e31a0c3e5a061645c09f805387b49fa9d35acbf"
pkgdesc="Firmware for OnePlus 6 / 6T"
url="https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845"
arch="aarch64"
depends="linux-firmware-qcom linux-firmware-ath10k"
license="proprietary"
subpackages="$pkgname-pmtest"
provides="$pkgname-sensors=$pkgver-r$pkgrel"
replaces="$pkgname-sensors"
source="$pkgname-$_commit.tar.gz::https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845/-/archive/$_commit/firmware-oneplus-sdm845-$_commit.tar.gz
	0001-oneplus6-set-mount-matrix.patch
	30-oneplus-sdm845-firmware-ci.files
	firmware-initramfs.files
	sensor_paths.txt
	"
options="
	!archcheck
	!check
	!strip
	!tracedeps
	pmb:cross-native
	textrels
	"
builddir="$srcdir/$pkgname-$_commit"

package() {
	local firmware_paths
	firmware_paths="
		postmarketos/tfa98xx.cnt
		postmarketos/qca/crbtfw21.tlv
		qcom/sdm845/OnePlus/enchilada/adspr.jsn
		qcom/sdm845/OnePlus/enchilada/adspua.jsn
		qcom/sdm845/OnePlus/enchilada/cdspr.jsn
		qcom/sdm845/OnePlus/enchilada/modemr.jsn
		qcom/sdm845/OnePlus/enchilada/modemuw.jsn
		qcom/sdm845/OnePlus/enchilada/slpir.jsn
		qcom/sdm845/OnePlus/enchilada/slpius.jsn
		qcom/sdm845/OnePlus/enchilada/slpi.mbn
		qcom/sdm845/OnePlus/enchilada/venus.mbn
		qcom/sdm845/OnePlus/enchilada/wlanmdsp.mbn
		qcom/sdm845/OnePlus/enchilada/a630_zap.mbn
		qcom/sdm845/OnePlus/enchilada/adsp.mbn
		qcom/sdm845/OnePlus/enchilada/cdsp.mbn
		qcom/sdm845/OnePlus/enchilada/ipa_fws.mbn
		qcom/sdm845/OnePlus/enchilada/mba.mbn
		qcom/sdm845/OnePlus/enchilada/modem.mbn
		qca/OnePlus/enchilada/crnv21.bin
	"

	# Regular firmware
	for firmware_path in $firmware_paths; do
		install -Dm644 "$builddir"/lib/firmware/"$firmware_path" \
			"$pkgdir"/usr/lib/firmware/"$firmware_path"
	done

	# mkinitfs inclusions
	install -Dm644 "$srcdir"/firmware-initramfs.files \
		"$pkgdir"/usr/share/mkinitfs/files/"$pkgname".files

	# Sensor firmware
	for sensor_path in $(cat "$srcdir"/sensor_paths.txt); do
		install -Dm644 "$builddir"/usr/share/qcom/sdm845/OnePlus/oneplus6/"$sensor_path" \
			"$pkgdir"/usr/share/qcom/sdm845/OnePlus/oneplus6/"$sensor_path"
	done

	ln -s oneplus6 "$pkgdir"/usr/share/qcom/sdm845/OnePlus/enchilada
	ln -s oneplus6 "$pkgdir"/usr/share/qcom/sdm845/OnePlus/fajita

	# pmtest
	install -Dm644 "$srcdir"/30-oneplus-sdm845-firmware-ci.files \
		"$pkgdir"/usr/share/mkinitfs/files/30-oneplus-sdm845-firmware-ci.files
}

pmtest() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-mkinitfs-hook-ci"

	amove usr/share/mkinitfs/files/30-oneplus-sdm845-firmware-ci.files
}

