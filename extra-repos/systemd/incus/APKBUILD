# Forked from Alpine to add systemd support

maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=incus
pkgver=99997.0.1
_pkgver=7.0.1 #LTS releases only
pkgrel=0
pkgdesc="Powerful system container and virtual machine manager"
url="https://github.com/lxc/incus"
arch="all"
license="Apache-2.0"
depends="
	acl
	attr
	ca-certificates
	dbus
	dnsmasq
	lxc>=6.0.0
	iproute2
	netcat-openbsd
	nftables
	rsync
	squashfs-tools
	shadow-subids
	tar
	xz
	"
makedepends="
	acl-dev
	autoconf
	automake
	cowsql-dev
	raft-cowsql-dev
	eudev-dev
	gettext-dev
	go
	intltool
	libcap-dev
	libtool
	libuv-dev
	linux-headers
	lxc-dev
	lz4-dev
	sqlite-dev
	systemd-dev
	tcl-dev
	"
subpackages="$pkgname-client
	$pkgname-agent
	$pkgname-agent-openrc:agent_openrc:noarch
	$pkgname-user
	$pkgname-user-openrc:user_openrc:noarch
	$pkgname-openrc
	$pkgname-systemd
	$pkgname-conversion
	$pkgname-utils
	$pkgname-bash-completion:bashcomp:noarch
	"
install="$pkgname.pre-install $pkgname.post-upgrade"
options="net !check"
if [ "$CARCH" = "loongarch64" ]; then
	options="$options !check" # random test failures on loongarch64
fi
source="$pkgname-$pkgver.tar.gz::https://github.com/lxc/incus/archive/refs/tags/v$_pkgver.tar.gz
	incusd.confd
	incusd.initd
	$pkgname-agent.initd
	$pkgname-user.initd
	incus-user.service
	incus-user.socket
	incus.service
	incus.socket
	incus.sysusers

	0001-statically-build-incus-agent-and-incus-migrate.patch
	"
builddir="$srcdir/$pkgname-$_pkgver"

# armhf, armv7, x86: no qemu on 32-bit
case "$CARCH" in
armhf|armv7|x86) ;;
*) subpackages="$subpackages $pkgname-vm:vm:noarch" ;;
esac

_tools="fuidshift
	generate-config
	generate-database
	incus
	incus-benchmark
	incus-migrate
	incus-simplestreams
	lxc-to-incus
	lxd-to-incus
	mini-oidc
	sysinfo
	tls2jwt
	"

_project="github.com/lxc/incus"

export GOFLAGS="$GOFLAGS -tags=libsqlite3"
export GOPATH="$srcdir"

