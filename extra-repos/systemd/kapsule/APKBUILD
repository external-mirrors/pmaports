6a5e47347f26dd4084db9c17c9af01d5b371dec42b14feb38bbea795f03d61c7abc49e314ccf09df500e6c4c48db582e4f0edd15955fe4502d7291b2a86ef26b  0001-kapsule-Support-more-filesystems.patch
c8c10e94c36e417abf1f6c7451bffae84eeff53f428f287558217ddf9383784b66a0246fcc0363be6e1d70cbb016367d83daac5a114d449ed97c3d4af6ed9317  kapsule.conf
"
