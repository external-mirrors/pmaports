# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kapsule
pkgver=0_git20260928
pkgrel=0
_commit="1bf6bba243726b185284d57032afd7c45bdebe24"
# armhf blocked by qt6-qtdeclarative -> ki18n
arch="all !armhf"
url="https://invent.kde.org/kde-linux/kapsule"
pkgdesc="Incus-based container management with native KDE/Plasma integration"
license="GPL-3.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause"
depends="
	incus
	incus-client
	py3-dbus-fast
	py3-httpx
	py3-psutil
	py3-pydantic
	py3-websockets
	py3-yaml
	"
makedepends="$depends_dev
	extra-cmake-modules
	kcmutils-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kio-dev
	python3
	qcoro-dev
	qt6-qtbase-dev
	samurai
	systemd
	"
subpackages="
	$pkgname-systemd
	$pkgname-dev
	"
_repo_url="https://invent.kde.org/kde-linux/kapsule.git"
source="$pkgname-$_commit.tar.gz::https://invent.kde.org/kde-linux/kapsule/-/archive/$_commit.tar.gz
	0001-kapsule-Support-more-filesystems.patch
	kapsule.conf
	"
options="!check" # No tests
builddir="$srcdir/$pkgname-$_commit"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DVENDOR_PYTHON_DEPS=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	rm "$pkgdir"/usr/lib/kapsule/kapsule.conf
	install -Dm644 "$srcdir"/kapsule.conf "$pkgdir"/usr/lib/kapsule/kapsule.conf
}

