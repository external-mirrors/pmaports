# Forked from Alpine to remove patch expecting udevadm in sbin. Drop after bin-merge
maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=hwinfo
_pkgver=26.0
pkgver=9999.$_pkgver
pkgrel=0
pkgdesc="Hardware information tool"
url="https://github.com/openSUSE/hwinfo"
arch="all"
license="GPL-2.0-or-later"
makedepends="flex perl linux-headers util-linux-dev libx86emu-dev"
subpackages="$pkgname-bash-completion $pkgname-dev $pkgname-doc $pkgname-libs"
source="$pkgname-$_pkgver.tar.gz::https://github.com/openSUSE/hwinfo/archive/$_pkgver.tar.gz
	respect-flags.patch
	"
options="!check !pmb:crossdirect"  # no tests provided
builddir="$srcdir/$pkgname-$_pkgver"

export HWINFO_VERSION=$_pkgver

build() {
	# HACK: print the "check_hd" program log, so pmbootstrap doesn't kill
	# the build after printing no output for 15 minutes. As mentioned below
	# this takes forever, and it is worse when running through QEMU.
	tail -F src/ids/hd.log &
	local tail_pid=$!

	# Build full and tiny static libraries.
	#make tinystatic  # FIXME: fails
	# this takes forever but it's not stuck
	make -j1 static
	cp src/libhd*.a .
	make clean

	# Build full shared library.
	make -j1 shared LIBDIR=/usr/lib

	# Avoid "umount: can't unmount …/chroot_native/dev: Resource busy"
	kill $tail_pid
}

package() {
	make install \
		LIBDIR=/usr/lib \
		DESTDIR="$pkgdir"

	rmdir "$pkgdir"/sbin "$pkgdir"/usr/lib || true

	install -m 644 -t "$pkgdir"/usr/lib/ libhd.a
	#install -m 644 -t "$pkgdir"/usr/lib/ libhd_tiny.a  # FIXME: disabled above

	install -Dm644 doc/*.1 -t "$pkgdir"/usr/share/man/man1/
	install -Dm644 doc/*.8 -t "$pkgdir"/usr/share/man/man8/
}

